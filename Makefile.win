Test/md2/maths.o: Test/md2/maths.cpp
	$(CPP) -c Test/md2/maths.cpp -o Test/md2/maths.o $(CXXFLAGS)

Test/md2/tga.o: Test/md2/tga.cpp
	$(CPP) -c Test/md2/tga.cpp -o Test/md2/tga.o $(CXXFLAGS)

Test/tinyXML/tinyxml.o: Test/tinyXML/tinyxml.cpp
	$(CPP) -c Test/tinyXML/tinyxml.cpp -o Test/tinyXML/tinyxml.o $(CXXFLAGS)

Test/tinyXML/tinyxmlerror.o: Test/tinyXML/tinyxmlerror.cpp
	$(CPP) -c Test/tinyXML/tinyxmlerror.cpp -o Test/tinyXML/tinyxmlerror.o $(CXXFLAGS)

Test/tinyXML/tinyxmlparser.o: Test/tinyXML/tinyxmlparser.cpp
	$(CPP) -c Test/tinyXML/tinyxmlparser.cpp -o Test/tinyXML/tinyxmlparser.o $(CXXFLAGS)

Test/main.o: Test/main.cpp
